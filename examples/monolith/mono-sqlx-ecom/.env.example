APP_ENV=development
PORT=3000

# ===== Databases =====
# Default: SQLite (no Docker needed). Uncomment Postgres or MySQL then `docker compose up -d`.
DATABASE_URL=sqlite:./mono_sqlx_ecom.db
# DATABASE_URL=postgres://ferrite:ferrite_pass@localhost:5432/ecom
# DATABASE_URL=mysql://ferrite:ferrite_pass@localhost:3306/ecom

# ===== JWT (auth) =====
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=3600

# ===== Redis (cache + throttler) =====
REDIS_URL=redis://localhost:6379

# ===== Kafka (async events: order.created, product.stock.decreased) =====
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=mono-sqlx-ecom-group

# ===== App meta =====
APP_NAME=mono-sqlx-ecom
