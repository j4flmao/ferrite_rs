APP_ENV=development
PORT=3002

# ===== Databases =====
DATABASE_URL=sqlite:./mono_sea_ecom.db
# DATABASE_URL=postgres://ferrite:ferrite_pass@localhost:5432/ecom
# DATABASE_URL=mysql://ferrite:ferrite_pass@localhost:3306/ecom

# ===== JWT (auth) =====
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=3600

# ===== Redis =====
REDIS_URL=redis://localhost:6379

# ===== Kafka =====
KAFKA_BROKERS=localhost:9092
KAFKA_GROUP_ID=mono-sea-ecom-group

# ===== App meta =====
APP_NAME=mono-sea-ecom
