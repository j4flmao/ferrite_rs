PORT=3005
GRPC_ADDR=0.0.0.0:50052
JWT_SECRET=replace-me-with-a-strong-32-byte-secret-please
JWT_EXPIRES_IN_SECONDS=86400
JWT_REFRESH_EXPIRES_IN_SECONDS=604800

# Pick one — matches Cargo.toml [features]
DATABASE_URL=sqlite://./data.sqlite?mode=rwc
# DATABASE_URL=postgres://ferrite:ferrite@localhost:5432/ferrite_micro_auth
# DATABASE_URL=mysql://ferrite:ferrite@localhost:3306/ferrite_micro_auth

REDIS_URL=redis://127.0.0.1:6379
CACHE_KEY_PREFIX=micro-auth:
KAFKA_BROKERS=localhost:9092
KAFKA_POLL_MS=100
KAFKA_BATCH=16
